# Local Ollama
RBXFORGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
RBXFORGE_OLLAMA_MODEL=qwen3:4b

# Optional Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# simple | moderate | complex
RBXFORGE_DEFAULT_COMPLEXITY=moderate

# Maximum number of file-agent tool calls per request
RBXFORGE_MAX_TOOL_CALLS=12

# LLM request timeouts (in seconds)
RBXFORGE_LLM_TIMEOUT=60.0
RBXFORGE_LLM_CONNECT_TIMEOUT=10.0
